#!/usr/bin/env bash
set -e

# Load a modern python for the proxy script
module use "/apps/eb/el8/skylake/modules/all"
module use "/apps/kir/eb/skylake/modules/all"
module load Python/3.10.8-GCCcore-12.2.0-bare
module load <%= context.mdv_module %>

# SIF path comes from the loaded module
echo "MDV version : ${MDV_VERSION}"
echo "SIF path    : ${MDV_SIF}"

MDV_PROJECTS_DIR="<%= context.mdv_projects_dir %>"

# ── Per-session ephemeral data directory on node-local /tmp ───────────────────
# Holds the PostgreSQL database, postgres logs, numba/matplotlib caches.
# Made unique per OOD session so concurrent sessions never collide on the
# postgres data dir / port 5432. The DB is rebuilt from MDV_PROJECTS_DIR on
# startup, so projects persist even though this directory is disposable.
MDV_DATA_DIR="/tmp/ondemand-mdv-<%= session.id %>"

# Remove this session's data dir when the job ends (normal exit or SIGTERM from
# scancel / walltime). SIGKILL can't be trapped - the sweep above is the backstop.
cleanup() {
    echo "$(date): Cleaning up ${MDV_DATA_DIR}"
    kill "${CONTAINER_PID}" 2>/dev/null || true
    rm -rf "${MDV_DATA_DIR}"
}
trap cleanup EXIT INT TERM

# Flask runs on an internal port; the proxy sits on BIND_PORT (what OOD knows about)
FLASK_PORT=$((BIND_PORT + 1))

echo "$(date): Starting MDV"
echo "  OOD proxy port : ${BIND_PORT}"
echo "  Flask port     : ${FLASK_PORT}"
echo "  Projects       : ${MDV_PROJECTS_DIR}"
echo "  Data           : ${MDV_DATA_DIR}"

mkdir -p "${MDV_DATA_DIR}"
mkdir -p "${MDV_PROJECTS_DIR}"

export APPTAINER_BIND="/gpfs3/well,/gpfs3/users"
export MDV_DATA_DIR
export PORT="${FLASK_PORT}"

# This is to solve https://github.com/kir-rescomp/ood-app-mdv/issues/14
export NUMBA_CACHE_DIR="${MDV_DATA_DIR}/numba_cache"
export MPLCONFIGDIR="${MDV_DATA_DIR}/matplotlib"
mkdir -p "${NUMBA_CACHE_DIR}" "${MPLCONFIGDIR}"
# Start MDV container in background on internal port
apptainer run \
  --env NUMBA_CACHE_DIR="${MDV_DATA_DIR}/numba_cache" \
  --env MPLCONFIGDIR="${MDV_DATA_DIR}/matplotlib" \
  --env MDV_DATA_DIR="${MDV_DATA_DIR}" \
  --env PORT="${FLASK_PORT}" \
  --bind "${MDV_DATA_DIR}:${MDV_DATA_DIR}" \
  --bind "${MDV_PROJECTS_DIR}:/app/mdv" \
  "${MDV_SIF}" &
CONTAINER_PID=$!

# Wait for Flask to be ready before starting the proxy
echo "Waiting for MDV to initialise..."
for i in $(seq 1 90); do
    if curl -sf "http://127.0.0.1:${FLASK_PORT}/" > /dev/null 2>&1; then
        echo "$(date): MDV ready on port ${FLASK_PORT}"
        break
    fi
    sleep 2
done

# Start the path-rewriting proxy on BIND_PORT (OOD connects here)
FLASK_PORT=${FLASK_PORT} \
BIND_PORT=${BIND_PORT} \
RNODE_PREFIX="${host}/${BIND_PORT}" \
    python3 "<%= session.staged_root %>/proxy.py"
