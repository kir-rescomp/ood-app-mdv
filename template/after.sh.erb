echo "$(date): Waiting for MDV to be ready on ${host}:${port}..."

# Gunicorn binds the port before its worker has loaded MDV, so an open port is not
# enough: wait until MDV answers over HTTP, so the Connect button only appears once
# the first page will load.
mdv_ready=false
for i in $(seq 1 150); do
  if curl -sf --noproxy '*' -o /dev/null "http://127.0.0.1:${port}/"; then
    mdv_ready=true
    break
  fi
  sleep 2
done

if [[ "${mdv_ready}" == true ]]; then
  echo "$(date): MDV is ready — connect button will now appear"
else
  echo "$(date): Timed out waiting for MDV to start after 300s"
  clean_up 1
fi
